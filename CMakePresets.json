{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
	"CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_LINKER_FLAGS": "-PROFILE"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
	{
      "name": "x64-develop",
      "binaryDir": "${sourceDir}/out/build/develop",
      "installDir": "${sourceDir}/out/install/develop",
      "displayName": "x64 develop",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-DNDEBUG -Od"
      }
    },

    {
      "name": "x64-relWithDebug",
      "displayName": "x64 RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-GL"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-GL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Release",
      "jobs": 12,
      "description": "",
      "displayName": "",
      "configurePreset": "x64-release"
    },
    {
      "name": "Debug",
      "jobs": 12,
      "description": "",
      "displayName": "",
      "configurePreset": "x64-debug"
    },
    {
      "name": "RelWithDebugInfo",
      "jobs": 12,
      "description": "",
      "displayName": "",
      "configurePreset": "x64-relWithDebug"
    }
  ]
}
